#include <inviwopy/pyinviwomodules.h>

#include <pybind11/functional.h>
#include <pybind11/stl.h>
#include <pybind11/stl/filesystem.h>
#include <pybind11/numpy.h>
#include <pybind11/eval.h>

#include <modules/python3/opaquetypes.h>
#include <modules/python3/polymorphictypehooks.h>

// Generated by CMake: using generatePythonModuleList in modules/python3/bindings/CMakeLists.txt
// template is pyinviwomodules.cpp.in

namespace inviwo {

void lazyLoadInviwoPythonModules(pybind11::module& m) {
    static constexpr auto names = std::to_array<std::pair<const char*, const char*>>({
@INVIWO_PYTHON_MODULES@ 
    });

    m.def("__getattr__", [](std::string name) {
        if(auto it = std::ranges::find_if(names, [name](const auto& pair) { return pair.first == name; }); it != names.end()) {
            const auto& [shortName, fullName] = *it;
            try {
                const pybind11::gil_scoped_acquire gil;
                auto m = pybind11::module::import(fullName);
                auto inviwopy = pybind11::module::import("inviwopy");
                inviwopy.attr(shortName) = m;
                return m;
            } catch (const std::exception& e) {
                throw pybind11::attribute_error(
                    fmt::format("unable to load '{}' {}", fullName, e.what()));
            }
        } else {
            throw pybind11::attribute_error(
                fmt::format("module 'inviwopy' has no attribute '{}'", name));
        }
    });

    m.def("__dir__", []() {
        auto keys = pybind11::list(pybind11::globals().attr("keys")());
        for (const auto& [shortName, name] : names) {
            keys.attr("append")(shortName);
        }
        return keys;
    });
}
}  // namespace inviwo
